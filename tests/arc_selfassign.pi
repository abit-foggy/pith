# [ARC] Reassignment hazards: self-assignment, aliasing, and chained
# overwrites. The retain-before-release ordering must keep `x = x`
# safe on heap strings; alias copies must hold balanced references.
# Expected: exit 0, zero leaks/double-frees under ASan.

mut x = "self" + "-assign"
x = x
if x == "self-assign"
    print "selfassign: self ok"
end

mut y = x
x = x
y = y
if y == x
    print "selfassign: alias ok"
end

mut a = "heap" + "-a"
b = a
a = b
if a == "heap-a"
    print "selfassign: heap alias ok"
end

mut c = "c1" + "-c"
c = c
c = c + "2"
if c == "c1-c2"
    print "selfassign: self then extend ok"
end

mut d = "d" + "-1"
d = d
d = "d" + "-2"
if d == "d-2"
    print "selfassign: replace after self ok"
end

mut e = "e" + "-1"
f = e
e = e + "-more"
if e == "e-1-more"
    print "selfassign: extend via alias ok"
end
if f == "e-1"
    print "selfassign: old alias intact ok"
end

mut g = "g" + "-x"
g = g + "-y"
g = g + "-z"
if g == "g-x-y-z"
    print "selfassign: chained concat ok"
end

print "selfassign: done"

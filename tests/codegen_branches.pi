# [CODEGEN] Control-flow oddities: empty then/elseif/else branches,
# unreachable code after return (diagnosed, not emitted), and chained
# comparisons. Expected: exit 0, every ok line printed.

if 1 == 0
else
end

if 1 == 1
else
    print "empty: unreachable"
end

if 2 > 1
    if 3 >= 3
        if 4 <= 4
            if 5 < 6
                if 6 != 7
                    print "empty: chain ok"
                end
            end
        end
    end
end

if 1 == 0
    print "empty: unreachable"
elseif 1 == 0
    print "empty: unreachable"
elseif 1 == 1
    print "empty: elseif hit ok"
else
    print "empty: unreachable"
end

if 1 == 0
    print "empty: unreachable"
elseif 2 == 2
    if 1 == 0
        print "empty: unreachable"
    else
        print "empty: nested else ok"
    end
end

fn deadEnd
    return 1
    print "dead code after return"
end

if 1 == 1
    print "empty: done"
end

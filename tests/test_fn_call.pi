# test_fn_call.pi - User-defined functions, parameters, recursion, and direct calls

fn add(a, b)
    return a + b
end

fn fib(n)
    if n <= 1
        return n
    end
    return fib(n - 1) + fib(n - 2)
end

fn sayHello
    print "hello from function"
end

sum = add(17, 25)
if sum == 42
    print "add: ok"
end

f = fib(7)
if f == 13
    print "fib: ok"
end

sayHello()

print "functions: done"
